GPIO4.associatedPins[5].$name                     = "PIN_5";
GPIO4.associatedPins[5].direction                 = "INPUT";
GPIO4.associatedPins[5].pin.$assign               = "PB25";
GPIO4.associatedPins[6].$name                     = "PIN_6";
